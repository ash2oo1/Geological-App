    <!-- المحرك البرمجي (JavaScript) -->
    <script>
        // 1. إعداد الخريطة
        // سنضع الإحداثيات المبدئية على منطقة جبلية (مثلاً جبال راوندوز أو منطقة افتراضية)
        let currentLat = 36.6111; 
        let currentLon = 44.5222;
        
        var map = L.map('map', {zoomControl: false}).setView([currentLat, currentLon], 11);
        
        L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}', {
            maxZoom: 17,
        }).addTo(map);

        // دبوس الهدف (القرية) - يبقى ثابتاً في منتصف الشاشة ونحن نحرك الخريطة تحته
        var targetIcon = L.divIcon({
            className: 'custom-map-marker',
            html: '<i class="fas fa-crosshairs" style="color:#ef4444; font-size:24px; text-shadow: 0 0 5px white;"></i>',
            iconSize: [24, 24]
        });
        var marker = L.marker([currentLat, currentLon], {icon: targetIcon}).addTo(map);

        // تحديث إحداثيات الدبوس عند تحريك الخريطة
        map.on('move', function () {
            var center = map.getCenter();
            marker.setLatLng(center);
            currentLat = center.lat;
            currentLon = center.lng;
        });

        // 2. دالة جلب بيانات المطر وتحليل الخطر
        async function analyzeRisk() {
            const loader = document.getElementById('loader');
            const btn = document.getElementById('btnAnalyze');
            
            loader.classList.add('active');
            btn.disabled = true;

            try {
                // سحب بيانات المطر المتراكمة لآخر 24 ساعة من Open-Meteo API (مجاني)
                // نطلب precipitation_sum
                const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${currentLat}&longitude=${currentLon}&daily=precipitation_sum&timezone=auto&past_days=1`);
                const data = await response.json();
                
                // أخذ كمية المطر لليوم السابق (أو الحالي حسب التحديث)
                let rain24h = data.daily.precipitation_sum[0] || 0;
                
                // لأغراض "التجربة" إذا كان المطر 0، سنقوم بتوليد رقم عشوائي لنرى الحالات المختلفة
                // في التطبيق الحقيقي سنحذف هذا السطر
                if(rain24h === 0) {
                    rain24h = Math.random() * 30; // رقم بين 0 و 30 ملم
                }

                rain24h = rain24h.toFixed(1);

                // حساب عتبة الخطر (Caine 1980 مبسطة لمدة 24 ساعة)
                // I = 14.82 * (24)^-0.39 = ~ 4.4 mm/hr (Total 24h = ~ 106mm)
                // للتطبيق المبدئي سنضع عتبة 24 ساعة (D=24) رقم ثابت لسهولة الفهم: 20mm للإنذار
                const thresholdDanger = 20.0;
                const thresholdWarning = 10.0;

                // تحديث واجهة الأرقام
                document.getElementById('valRain').innerText = `${rain24h} mm`;
                document.getElementById('valCaine').innerText = `${thresholdDanger} mm`;

                // تغيير حالة الواجهة بناءً على النتيجة
                updateStatusUI(rain24h, thresholdWarning, thresholdDanger);

            } catch (error) {
                console.error("Error fetching data:", error);
                alert("Failed to fetch weather data. Check your internet connection.");
            } finally {
                loader.classList.remove('active');
                btn.disabled = false;
            }
        }

        // 3. دالة تحديث الألوان والنصوص (UX)
        function updateStatusUI(rain, tWarn, tDanger) {
            const card = document.getElementById('statusCard');
            const icon = document.getElementById('statusIcon');
            const title = document.getElementById('statusTitle');
            const desc = document.getElementById('statusDesc');
            const evac = document.getElementById('evacRules');

            // إزالة جميع الكلاسات السابقة
            card.className = "status-card";
            evac.classList.remove('active');

            if (rain >= tDanger) {
                // خطر (أحمر)
                card.classList.add("status-danger");
                icon.innerHTML = '<i class="fas fa-exclamation-triangle"></i>';
                title.innerText = "High Danger";
                desc.innerText = "Rainfall has exceeded safe thresholds. High probability of landslides in steep areas.";
                evac.classList.add('active'); // إظهار تعليمات الإخلاء
            } 
            else if (rain >= tWarn) {
                // تحذير (أصفر)
                card.classList.add("status-warning");
                icon.innerHTML = '<i class="fas fa-exclamation"></i>';
                title.innerText = "Warning State";
                desc.innerText = "Soil is saturated. Watch for minor rockfalls. Avoid steep unpaved trails.";
            } 
            else {
                // آمن (أخضر)
                card.classList.add("status-safe");
                icon.innerHTML = '<i class="fas fa-shield-alt"></i>';
                title.innerText = "Safe Zone";
                desc.innerText = "Current rainfall is well below the landslide threshold. Soil is stable.";
            }
        }
    </script>
</body>
</html>
"""
